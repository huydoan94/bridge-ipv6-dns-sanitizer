#!/bin/sh /etc/rc.common

USE_PROCD=1

START=20
STOP=89

EXTRA_COMMANDS="detach"
EXTRA_HELP="	detach	Stop the service and detach the sanitizer from every device"

CONF=l2dns6rw
PROG=/usr/sbin/$CONF
RESPAWN_THRESHOLD_SECONDS=3600
RESPAWN_DELAY_SECONDS=5
RESPAWN_RETRY_LIMIT=5
DEFAULT_VERBOSE=0

service_log()
{
	local priority="$1"
	shift
	logger -s -t "$CONF" -p "daemon.$priority" "$*"
}

start_service()
{
	local device devices dns_server dns_servers verbose

	config_load "$CONF"
	config_get devices main device
	config_get dns_servers main dns_server
	config_get_bool verbose main verbose "$DEFAULT_VERBOSE"

	if [ -z "$devices" ]; then
		service_log err "required option main.device is missing; add for example: list device 'l2vl0'"
		return 1
	fi

	if ! uci_validate_section "$CONF" sanitizer main \
		'device:list(netdevice)' \
		'dns_server:list(ip6addr)'; then
		service_log err "option main.device must name devices and main.dns_server must hold IPv6 addresses"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	for device in $devices; do
		procd_append_param command -i "$device"
	done
	for dns_server in $dns_servers; do
		procd_append_param command -d "$dns_server"
	done
	[ "$verbose" -eq 1 ] && procd_append_param command -v
	procd_set_param respawn "$RESPAWN_THRESHOLD_SECONDS" "$RESPAWN_DELAY_SECONDS" "$RESPAWN_RETRY_LIMIT"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# The sanitizer stays attached while the service is stopped or restarting,
# so packets are never forwarded unsanitized in between; this removes it.
detach()
{
	stop
	"$PROG" -D
}

service_triggers()
{
	procd_add_reload_trigger "$CONF"
}
