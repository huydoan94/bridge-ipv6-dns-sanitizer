#!/bin/sh /etc/rc.common

USE_PROCD=1

START=20
STOP=89

CONF=l2dns6rw
PROG=/usr/sbin/$CONF
NFT=${NFT:-/usr/sbin/nft}
QUEUE_NUMBER_MAX=65535
RESPAWN_THRESHOLD_SECONDS=3600
RESPAWN_DELAY_SECONDS=5
RESPAWN_RETRY_LIMIT=5
DEFAULT_VERBOSE=0

service_log()
{
	local priority="$1"
	shift
	logger -s -t "$CONF" -p "daemon.$priority" "$*"
}

queue_number_valid()
{
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac

	[ "$1" -le "$QUEUE_NUMBER_MAX" ] 2>/dev/null
}

nft_queue_rule_exists()
{
	local queue_number="$1"
	local ruleset

	ruleset=$("$NFT" --numeric list ruleset 2>/dev/null) || return 2
	printf '%s\n' "$ruleset" | nft_ruleset_has_queue "$queue_number"
}

queue_spec_matches()
{
	local queue_number="$1"
	local queue_spec="$2"
	local first last

	queue_spec=${queue_spec%,}
	queue_spec=${queue_spec%;}

	case "$queue_spec" in
		*-*)
			first=${queue_spec%%-*}
			last=${queue_spec#*-}
			queue_number_valid "$first" || return 1
			queue_number_valid "$last" || return 1
			[ "$queue_number" -ge "$first" ] && \
				[ "$queue_number" -le "$last" ]
			;;
		*)
			queue_number_valid "$queue_spec" || return 1
			[ "$queue_number" -eq "$queue_spec" ]
			;;
	esac
}

nft_ruleset_has_queue()
{
	local queue_number="$1"
	local line
	local in_queue

	set -f
	while IFS= read -r line; do
		set -- $line
		in_queue=
		while [ "$#" -gt 0 ]; do
			if [ -n "$in_queue" ]; then
				case "$1" in
					num|to)
						if [ "$#" -ge 2 ] && queue_spec_matches "$queue_number" "$2"; then
							set +f
							return 0
						fi
						;;
				esac
			elif [ "$1" = queue ]; then
				in_queue=1
			fi
			shift
		done
	done
	set +f
	return 1
}

check_nft_queue()
{
	local queue_number="$1"
	local status

	nft_queue_rule_exists "$queue_number"
	status=$?

	if [ "$status" -eq 0 ]; then
		service_log info "nftables rule found for NFQUEUE $queue_number"
		return 0
	elif [ "$status" -eq 1 ]; then
		service_log warn "no nftables rule queues packets to NFQUEUE $queue_number; continuing"
	else
		service_log warn "could not inspect nftables rules for NFQUEUE $queue_number; continuing"
	fi
}

start_service()
{
	local dns_server dns_servers queue_number verbose

	config_load "$CONF"
	config_get queue_number main queue_number
	config_get_bool verbose main verbose "$DEFAULT_VERBOSE"

	if ! queue_number_valid "$queue_number"; then
		service_log err "required option main.queue_number is missing or outside 0-$QUEUE_NUMBER_MAX"
		return 1
	fi

	if ! uci_validate_section "$CONF" sanitizer main \
		'dns_server:list(ip6addr)'; then
		service_log err "option main.dns_server must contain only IPv6 addresses"
		return 1
	fi

	dns_servers="$dns_server"

	check_nft_queue "$queue_number"

	procd_open_instance
	procd_set_param command "$PROG" -q "$queue_number"
	for dns_server in $dns_servers; do
		procd_append_param command -d "$dns_server"
	done
	[ "$verbose" -eq 1 ] && procd_append_param command -v
	procd_set_param respawn "$RESPAWN_THRESHOLD_SECONDS" "$RESPAWN_DELAY_SECONDS" "$RESPAWN_RETRY_LIMIT"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger "$CONF"
}
