
config sanitizer 'main'
	# Devices whose incoming RAs and DHCPv6 replies are sanitized, for example
	# the VXLAN port of the bridge. Required, at most 16.
	# list device 'l2vl0'
	# 1 also logs each rewritten packet; every drop is always logged.
	option verbose '0'
	# DNS servers to advertise, at most 8. Without any, each device's own ULA
	# (or its bridge's) is advertised.
	# list dns_server 'fd00::53'
	# list dns_server '2001:db8::53'

