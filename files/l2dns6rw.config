config sanitizer 'main'
	# Devices whose incoming RAs and DHCPv6 replies are sanitized, for example
	# the VXLAN port of the bridge. Required.
	# list device 'l2vl0'
	option verbose '0'
	# DNS servers to advertise. Without any, each device's own ULA (or its
	# bridge's) is advertised.
	# list dns_server 'fd00::53'
	# list dns_server '2001:db8::53'
