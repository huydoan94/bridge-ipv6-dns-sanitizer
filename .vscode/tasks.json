{
    // The test and build tasks run tools/host-test.sh and tools/sdk-build.sh.
    // SDK locations default to siblings of this repository (../openwrt-sdk-x86,
    // ../openwrt-sdk-filogic); set OPENWRT_SDK_X86 or OPENWRT_SDK_FILOGIC to
    // override. Each SDK's package/l2dns6rw must link to this repository. The
    // host tests cover the daemon's logic; the BPF program's packet tests run
    // in a kernel, so the VM task runs them on the test VM it asks for.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test l2dns6rw (host)",
            "type": "shell",
            "command": "sh tools/host-test.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Test BPF program (VM)",
            "type": "shell",
            "command": "sh tests/bpf/run.sh ${input:vm}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Generate compile_commands.json (IntelliSense)",
            "type": "shell",
            "command": "sh tools/compile-commands.sh x86",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        },
        {
            "label": "Build l2dns6rw (OpenWrt SDK x86)",
            "type": "shell",
            "command": "sh tools/sdk-build.sh x86",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build l2dns6rw (OpenWrt SDK filogic)",
            "type": "shell",
            "command": "sh tools/sdk-build.sh filogic",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        }
    ],
    "inputs": [
        {
            "id": "vm",
            "type": "promptString",
            "description": "Test VM (user@host)",
            "default": "root@192.168.56.2"
        }
    ]
}
